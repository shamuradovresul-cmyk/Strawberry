# Токен бота от @BotFather
BOT_TOKEN=вставь_токен_сюда

# Local Bot API Server — нужен только если хочешь принимать файлы > 50 МБ
# Для начала оставь пустым
LOCAL_API_URL=

# Модель Whisper:
#   tiny  — 200 МБ RAM, быстро, качество среднее   <- для сервера с 2 ГБ RAM
#   small — 500 МБ RAM, медленнее, качество лучше
#   medium— 1.5 ГБ RAM, ещё лучше (нужно 4+ ГБ RAM)
WHISPER_MODEL=tiny

# Максимальная длина видео в секундах (5400 = 90 минут)
MAX_VIDEO_DURATION=5400

# Папка для временных файлов (обычный диск, не RAM)
TEMP_DIR=/tmp/subtitle_bot
