# ── Обязательно ───────────────────────────────────────────────────────────────

# Токен бота от @BotFather
BOT_TOKEN=вставь_токен_сюда

# API credentials с https://my.telegram.org → API development tools
# Нужны для Local Bot API Server (без них файлы > 50 МБ не скачать)
TELEGRAM_API_ID=вставь_api_id_сюда
TELEGRAM_API_HASH=вставь_api_hash_сюда

# ── Настройки бота ────────────────────────────────────────────────────────────

# Адрес Local Bot API Server (не менять если используешь docker-compose)
LOCAL_API_URL=http://localhost:8081

# Модель Whisper:
#   tiny   — 200 МБ RAM, быстро  ← для сервера 2 ГБ RAM
#   small  — 500 МБ RAM, точнее  ← для сервера 4 ГБ RAM
#   medium — 1.5 ГБ RAM, хорошо  ← для сервера 6+ ГБ RAM
WHISPER_MODEL=tiny

# Максимальная длина видео в секундах (5400 = 90 минут)
MAX_VIDEO_DURATION=5400

# Папка для временных файлов (на диске)
TEMP_DIR=/tmp/subtitle_bot
