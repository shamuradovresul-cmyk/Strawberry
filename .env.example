# Telegram Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram API credentials from https://my.telegram.org
# Required for Local Bot API Server (removes 50MB file size limit)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Local Bot API Server URL (used inside docker-compose network)
LOCAL_API_URL=http://telegram-bot-api:8081

# Whisper model: tiny / base / small / medium / large-v3
WHISPER_MODEL=medium

# Max video duration in seconds (5400 = 90 minutes)
MAX_VIDEO_DURATION=5400

# Temporary files directory — use /dev/shm for RAM-only storage (no disk writes)
TEMP_DIR=/dev/shm/subtitle_bot
